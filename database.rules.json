{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (data.exists() ? data.child('hostUid').val() === auth.uid : newData.child('hostUid').val() === auth.uid)",
          ".validate": "$code.matches(/^[A-Z2-9]{5}$/) && newData.hasChildren(['hostUid', 'createdAt', 'status'])"
        },
        "state": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 8"
          }
        },
        "topics": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          }
        },
        "maps": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)"
          }
        },
        "guesses": {
          "$main": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)"
            }
          }
        },
        "requests": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['action', 'key']) && newData.child('action').isString() && newData.child('action').val().length <= 10"
          }
        },
        "viewers": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !root.child('rooms/' + $code + '/kicked/' + $uid).exists()) || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 8"
          }
        },
        "vguesses": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !root.child('rooms/' + $code + '/kicked/' + $uid).exists()) || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['gameNo', 'roundNo', 'placements'])"
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "scores": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "custom": {
          "$id": {
            ".write": "auth != null && (auth.uid === $id || root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid)",
            ".validate": "$id.length <= 40 && (newData.hasChild('none') || (newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 12 && newData.child('axes').hasChildren(['top', 'bottom', 'left', 'right']) && newData.child('words').hasChildren(['0', '1', '2', '3', '4'])))"
          }
        }
      }
    },
    "stats": {
      ".read": "auth != null",
      "$topicId": {
        "$entry": {
          ".write": "auth != null && !data.exists()",
          ".validate": "$topicId.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['p', 'at']) && newData.child('p').hasChildren(['0', '1', '2', '3', '4'])"
        }
      }
    }
  }
}
